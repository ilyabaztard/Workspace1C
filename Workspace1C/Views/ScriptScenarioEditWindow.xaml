<Window x:Class="Workspace1C.ScriptScenarioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="Сценарий"
        Width="660" Height="720" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <!-- Темизация окна редактирования сценария (issue #291): стили из LightTheme/DarkTheme,
             как у остальных окон (BackupScenarioEditWindow и др.). -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootPanel" Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,8,0" Padding="6,4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" Width="90" Padding="6,4" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="NameLabel" Text="Наименование" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,0,0,10"/>

                <TextBlock x:Name="FilePathLabel" Text="Путь к файлу" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilePathBox" Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Padding="4" TextChanged="OnTextChanged"/>
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="Обзор…" Width="90" Padding="6,3" Click="Browse_Click"/>
                </Grid>

                <!-- Issue #308, п.7: «Папка запуска» — рабочий каталог процесса скрипта
                     (WorkingDirectory); пусто — наследуется каталог приложения. -->
                <TextBlock x:Name="WorkingDirectoryLabel" Text="Папка запуска" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkingDirectoryBox" Grid.Column="0" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="4" TextChanged="OnTextChanged"/>
                    <Button x:Name="WorkingDirectoryBrowseButton" Grid.Column="2" Content="Обзор…" Width="90" Padding="6,3" Click="BrowseWorkingDirectory_Click"/>
                </Grid>

                <!-- Issue #308, п.9: «Интерпретатор» — выбор shell запуска:
                     Авто (по платформе) / cmd / PowerShell / sh. -->
                <TextBlock x:Name="ShellLabel" Text="Интерпретатор" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <!-- Issue #308, п.14:39: галки «Скрывать окно скрипта» и «Уведомлять
                     о запуске» — в одной строке с «Интерпретатор», чтобы не терялись
                     внизу окна. При снятой «Скрывать окно» на Windows показывается
                     консольное окно cmd; при выключенной «Уведомлять о запуске» не
                     показывается окно «скрипт запущен» и не шлются системные
                     уведомления (issue #308). -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ShellCombo" Grid.Column="0" SelectedValuePath="Key" DisplayMemberPath="Value"
                              HorizontalAlignment="Left" MinWidth="220"
                              SelectionChanged="OnSelectionChanged"/>
                    <CheckBox x:Name="HideWindowCheckBox" Grid.Column="2"
                              IsChecked="{Binding HideWindow, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center">
                        <!-- Метки чекбоксов переносятся (issue #55): при узком окне надписи
                             не обрезаются правым краем. -->
                        <TextBlock Text="{loc:Loc Script.HideWindow}" TextWrapping="Wrap" MaxWidth="150" VerticalAlignment="Center"/>
                    </CheckBox>
                    <CheckBox x:Name="NotifyOnStartCheckBox" Grid.Column="4"
                              IsChecked="{Binding NotifyOnStart, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Script.NotifyOnStart}" TextWrapping="Wrap" MaxWidth="150" VerticalAlignment="Center"/>
                    </CheckBox>
                </Grid>

                <TextBlock x:Name="ParametersLabel" Text="Параметры" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="ParametersBox" Text="{Binding ParametersText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="150"
                         VerticalScrollBarVisibility="Auto" Padding="4" Margin="0,0,0,4" TextChanged="OnTextChanged"/>
                <TextBlock x:Name="ParametersHint" Text="" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="2,0,0,10"/>

                <TextBlock x:Name="TokensLabel" Text="Подстановки" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <!-- Issue #308: в списке отображается «%token% — описание», двойной клик
                     вставляет только сам токен (DataTemplate по объекту ScriptTokenHint). -->
                <ListBox x:Name="TokensList" Height="130" Margin="0,0,0,4" MouseDoubleClick="TokensList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Token}" FontWeight="SemiBold"/>
                                <TextBlock Text=" — "/>
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Issue #67: кнопка «Выбрать…» — слева от поясняющей надписи; открывает
                     диалог со ВСЕМИ переменными базы (имя — значение) и поиском. -->
                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                    <Button x:Name="PickTokenButton" Style="{DynamicResource SecondaryButton}"
                            Content="{loc:Loc Script.PickButton}" Padding="10,3"
                            Click="OnPickToken_Click" Cursor="Hand"/>
                    <TextBlock x:Name="TokensHint" Text="" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock x:Name="ExampleBaseLabel" Text="База для примера подстановок" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <!-- Issue #308, п.14:37: явный ItemTemplate — закрытый комбобокс показывает
                     имя базы, а не ToString() объекта (имя типа Infobase). Рядом — галка
                     «Не закрывать»: добавляет хвост pause/Read-Host/read к команде
                     (issue #308). -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ExampleBaseCombo" Grid.Column="0" HorizontalAlignment="Left" MinWidth="260"
                              SelectionChanged="OnSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox x:Name="KeepOpenCheckBox" Grid.Column="2" Content="{loc:Loc Script.KeepOpen}"
                              IsChecked="{Binding KeepOpen, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
                <!-- Issue #61: подписи полей — единая кисть формы FormLabelBrush, итоговая
                     строка запуска — стиль ModernTextBox (фон/текст читаемы в обеих темах). -->
                <TextBlock x:Name="PreviewLabel" Text="" Foreground="{DynamicResource FormLabelBrush}" FontSize="11" Margin="2,0,0,2"/>
                <TextBox x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap" Padding="4" Margin="0,0,0,10"
                         Style="{StaticResource ModernTextBox}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>