<Window x:Class="Workspace1C.RacInfobaseDropRetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Title="{loc:Loc ServerMonitor.Infobase.Drop.RetryTitle}"
        Width="520" Height="440" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Диалог повтора удаления информационной базы кластера (issue #69): при неудачном
         «infobase drop» (например, защищённая база) вместо простого окна с OK показываем
         текст ошибки и поля «Логин»/«Пароль» администратора ИБ. «Повторить попытку» —
         ещё один rac-вызов с введёнными учётными данными, «Отмена» — прервать удаление.
         Подписи полей — через FormLabelBrush (issue #61): новое окно сразу пишется с ней. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource FormLabelBrush}"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Кнопки внизу: «Завершить сеансы и повторить» (только когда базe мешают
             активные сеансы/соединения, issue #69), «Повторить попытку» (default) и
             «Отмена» (cancel). -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="TerminateSessionsButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="14,6"
                    Margin="0,0,8,0" Visibility="Collapsed"
                    Click="OnTerminateSessions_Click">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Drop.TerminateSessionsButton}"
                           TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="RetryButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource AccentBrush}" Padding="18,6"
                    Margin="0,0,8,0" IsDefault="True" Click="OnRetry_Click">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Drop.RetryButton}"
                           VerticalAlignment="Center" Foreground="White"/>
            </Button>
            <Button Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="16,6"
                    IsCancel="True" Click="OnCancel_Click">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Drop.CancelButton}"
                           VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <StackPanel>
            <!-- Подпись: «Не удалось удалить информационную базу. <детали ошибки rac>». -->
            <TextBlock x:Name="ErrorText" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>

            <!-- Пояснение: что ввести и зачем (issue #69). -->
            <TextBlock x:Name="PromptText" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>

            <!-- Подсказка по типовой ошибке rac (issue #69): права/аутентификация ИБ,
                 активные сеансы/соединения или сервер СУБД. Текст задаётся в code-behind
                 по классификации ошибки (ClassifyDropError); скрыта, если тип не распознан. -->
            <TextBlock x:Name="SuggestionText" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

            <!-- Логин администратора ИБ (сохраняется между попытками). -->
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="{loc:Loc ServerMonitor.Infobase.Drop.RetryLogin}"/>
            <TextBox x:Name="LoginBox" Style="{StaticResource Field}" MaxLength="200"/>

            <!-- Пароль администратора ИБ (сохраняется между показами диалога,
                 комментарий 7OH от 2026-10-26: «Пароль сохранять между попытками»). -->
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="{loc:Loc ServerMonitor.Infobase.Drop.RetryPassword}"/>
            <PasswordBox x:Name="PasswordBox" Padding="6,3" MaxLength="200"
                         PasswordChar="●"/>

            <!-- Галочка «Установить блокировку регламентных заданий» (issue #69, комментарий
                 7OH от 2026-10-26): видна с ПЕРВОГО показа диалога — сразу при запросе
                 логина/пароля («И может быть сразу галочку показывать - ещё при первом
                 запросе логина и пароля?»). Если отмечается, перед завершением сеансов /
                 повторным «infobase drop» сначала выполняется rac «infobase update»
                 с параметром «scheduled-jobs-deny=on». -->
            <CheckBox x:Name="BlockScheduledJobsCheckBox" Margin="0,10,0,0">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Drop.BlockScheduledJobs}"
                           TextWrapping="Wrap"/>
            </CheckBox>
        </StackPanel>
    </DockPanel>
</Window>