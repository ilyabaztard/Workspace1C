<!-- Окно «Сменить платформу» (issue #54, переработка по комментарию 7OH, Windows/WPF):
     выбор версии платформы 1С из установленных и замена её у ВЫДЕЛЕННЫХ баз по «ОК».
     Вся логика — в чистой PlatformChangeViewModel (применение через
     ConnectionReplacementPlanner.ApplyPlatform, undo через MainViewModel.ApplyConnectionReplace);
     окно — тонкая обёртка: ComboBox установленных версий, сводка и кнопки «Сменить»/«Отмена».
     Ключи локализации PlatformChange.*. -->
<Window x:Class="Workspace1C.PlatformChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="460"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <!-- Выбор версии платформы. -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Loc PlatformChange.PlatformLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="260" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding InstalledPlatformVersions}"
                      SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}"
                      VerticalContentAlignment="Center" Padding="6,2"/>
        </StackPanel>

        <!-- Сводка: число баз, которым будет изменена платформа. -->
        <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding ResultText}" FontSize="12" Opacity="0.85" Margin="0,6,0,0"/>

        <!-- Действия: Сменить / Отмена. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ApplyButton" Style="{StaticResource ModernButton}"
                    Background="#22C55E" Foreground="White" Padding="18,6"
                    Margin="0,0,8,0" IsEnabled="{Binding CanApply}" Click="OnApply_Click">
                <TextBlock Text="{loc:Loc PlatformChange.ApplyButton}" Foreground="White"/>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource ModernButton}"
                    Background="{DynamicResource ItemHoverBrush}" Padding="18,6"
                    Click="OnCancel_Click">
                <TextBlock Text="{loc:Loc Common.Cancel}"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>