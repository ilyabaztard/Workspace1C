<Window x:Class="Workspace1C.ExportsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список выгрузок"
        Width="820" Height="520" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Content="Обновить" Width="100" Margin="0,0,8,0" Padding="6,4"
                    Style="{DynamicResource SecondaryButton}" Click="Refresh_Click"/>
            <Button x:Name="RestoreButton" Content="Восстановить" Width="110" Margin="0,0,8,0" Padding="6,4"
                    Style="{DynamicResource SecondaryButton}" Click="Restore_Click"/>
            <Button x:Name="OpenFolderButton" Content="Открыть папку" Width="110" Margin="0,0,8,0" Padding="6,4"
                    Style="{DynamicResource SecondaryButton}" Click="OpenFolder_Click"/>
            <Button Content="Закрыть" Width="90" Padding="6,4" IsCancel="True"
                    Style="{DynamicResource SecondaryButton}" Click="Close_Click"/>
        </StackPanel>

        <ListView x:Name="ExportsList" SelectionChanged="ExportsList_SelectionChanged" Margin="0,0,0,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="ColFileName" Header="Файл" Width="220" DisplayMemberBinding="{Binding FileName}"/>
                    <GridViewColumn x:Name="ColDirectory" Header="Каталог" Width="280" DisplayMemberBinding="{Binding Directory}"/>
                    <GridViewColumn x:Name="ColSize" Header="Размер" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn x:Name="ColDate" Header="Дата" Width="130" DisplayMemberBinding="{Binding LastWriteText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>