<Window x:Class="Workspace1C.RacInfobaseDropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Title="{loc:Loc ServerMonitor.Infobase.Drop.Title}"
        Width="560" Height="300" MinWidth="520" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <!-- Диалог удаления информационной базы кластера (issue #3, комментарий 7OH от
         2026-10-17): выбор «Просто удалить из кластера» или «Удалить с удалением на
         сервере СУБД». В кластере бывают только клиент-серверные базы (7OH 18.10 20:24
         и 19.10 19:12), поэтому вариант «с удалением на сервере СУБД» доступен всегда
         (1.0.0.21). Команда rac: infobase drop с флагом удаления БД. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Кнопки внизу — единый контракт (issue #26): удаление базы — опасная
             DangerButton (красная заливка, белый текст), «Отмена» — вторичная
             SecondaryButton. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DropButton" Style="{StaticResource DangerButton}"
                    Padding="18,6" Margin="0,0,8,0"
                    IsDefault="True" Click="OnDrop_Click">
                <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Drop.Confirm}"
                           VerticalAlignment="Center"/>
            </Button>
            <Button Style="{StaticResource SecondaryButton}"
                    Padding="16,6"
                    IsCancel="True" Click="OnCancel_Click">
                <TextBlock Text="{loc:Loc Updates.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <StackPanel>
            <!-- Вопрос: имя базы. -->
            <TextBlock x:Name="QuestionText" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,4"/>

            <!-- Диагностика (issue #3, часть 1): распознанный тип СУБД и сервер СУБД.
                 Показывается, только если тип СУБД непустой — иначе сразу видно,
                 что распарсилось из summary (например кавычки «"MSSQLServer"»). -->
            <TextBlock x:Name="DbmsInfoText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

            <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                    <RadioButton x:Name="FromClusterRadio" IsChecked="True" Margin="0,2,0,10"
                                 VerticalContentAlignment="Center"
                                 GroupName="DropOption">
                        <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Drop.OnlyFromCluster}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </RadioButton>
                    <RadioButton x:Name="DropDatabaseRadio" Margin="0,2,0,0"
                                 VerticalContentAlignment="Center"
                                 GroupName="DropOption"
                                 Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc ServerMonitor.Infobase.Drop.WithDatabase}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </RadioButton>
                </StackPanel>
            </Border>

        </StackPanel>
    </DockPanel>
</Window>