<!-- Окно «Выбор переменной» подстановок сценариев (issue #67): дерево/список
     «итоговое имя переменной — значение для базы», поиск по обеим колонкам,
     вставка токена по «Ок» и двойному клику. WPF-версия; Avalonia —
     ScriptTokenPickerWindow.Avalonia.cs. -->
<Window x:Class="Workspace1C.ScriptTokenPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Icon="{StaticResource AppIcon}"
        Title="{loc:Loc Script.TokenPickerTitle}"
        Width="760" Height="520" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="13"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск по обеим колонкам (имя переменной и значение). -->
        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,8"
                 ToolTip="{loc:Loc Script.TokenSearch}"
                 TextChanged="OnSearchTextChanged"/>

        <ListBox x:Name="TokenList" Grid.Row="1"
                 MouseDoubleClick="OnTokenDoubleClick"
                 SelectionMode="Single"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Token}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="130" Height="34" Margin="0,0,10,0" IsDefault="True" Click="OnOk_Click"
                    Background="#16A34A" BorderThickness="0" Foreground="White" Cursor="Hand">
                <TextBlock Text="{loc:Loc Common.Ok}" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Button>
            <Button Width="130" Height="34" IsCancel="True" Click="OnCancel_Click"
                    Background="{DynamicResource ItemHoverBrush}" Cursor="Hand">
                <TextBlock Text="{loc:Loc Common.Cancel}" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>