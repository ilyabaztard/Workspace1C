<Window x:Class="Workspace1C.Services.MaterialMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Workspace1C.Localization"
        Title="{loc:Loc Common.Information}"
        Icon="{StaticResource AppIcon}"
        SizeToContent="WidthAndHeight"
        Width="440"
        MaxWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Border Padding="0" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка типа сообщения -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                    Width="44" Height="44" CornerRadius="22" Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ItemHoverBrush}">
                <materialDesign:PackIcon x:Name="MessageIcon" Kind="InformationOutline"
                                         Width="24" Height="24" Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Текст сообщения -->
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MessageText"
                       TextWrapping="Wrap" FontSize="13" VerticalAlignment="Top"/>

            <!-- Кнопки: «Да» (подтверждение) слева, «Нет» (отмена) справа.
                 Единый контракт кнопок (issue #26): подтверждение — ModernButton
                 (акцентная заливка AccentBrush + контрастный TextOnAccentBrush),
                 отмена — SecondaryButton (карточка + контур + текст темы).
                 Прежняя жёсткая зелёная кнопка #16A34A с белым текстом убрана. -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="OkButton" MinWidth="100" Height="34" IsDefault="True"
                        Style="{DynamicResource ModernButton}" Margin="0,0,10,0"
                        Click="OnOkClick">
                    <TextBlock x:Name="OkText" Text="{loc:Loc Common.Ok}" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="13"
                               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                </Button>
                <Button x:Name="CancelButton" MinWidth="90" Height="34"
                        Style="{DynamicResource SecondaryButton}" Visibility="Collapsed"
                        IsCancel="True" Click="OnCancelClick">
                    <TextBlock x:Name="CancelText" Text="{loc:Loc Common.No}" VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>